# Copy to .env and load with: node --env-file=.env server/server.mjs
HOST=127.0.0.1
PORT=8787
# Public origin of THIS Node backend (used for OAuth redirects, cookies, CORS).
# Local: http://127.0.0.1:8787
# Tunnel/Tailscale HTTPS: https://your-host.your-tailnet.ts.net
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Public origin of the static frontend (Cloudflare Pages). Same-origin by default.
# Example: FRONTEND_URL=https://wrosecode-web.pages.dev
# When set and different from PUBLIC_BASE_URL, the backend enables CORS with
# credentials and uses SameSite=None; Secure cookies (requires HTTPS backend).
FRONTEND_URL=
DATA_DIR=./data
# disabled, mock, cli; switch to cli only on your trusted Kali machine
BRIDGE_MODE=disabled
WROSECODE_BIN=wrosecode
# Local Rust agent API (never expose 4076 to the public internet).
WROSE_URL=http://127.0.0.1:4076
# Bearer-token file for the Rust server. Defaults check $HOME/.wrosecode/server.token,
# then /root/.wrosecode/server.token and /home/kali/.wrosecode/server.token.
# Override only to use a different safe local path.
WROSE_TOKEN_FILE=
MAX_JOB_SECONDS=300
MAX_CONCURRENT_JOBS=2
# Keep closed for a private console; open allows sign-ups, NOT run permissions
SIGNUP_MODE=closed
# DO NOT enable member execution without actual per-user sandboxing
ALLOW_MEMBER_JOBS=0
I_ACCEPT_SHARED_CLI_RISK=no
# OAuth credentials from YOUR Google/GitHub application (optional, server-side only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
