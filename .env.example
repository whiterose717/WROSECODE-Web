# Copy to .env locally. Do not upload this file with real values.
HOST=127.0.0.1
PORT=8787
# Public HTTPS address of Node backend (for Tunnel and OAuth callbacks)
PUBLIC_BASE_URL=http://127.0.0.1:8787
# PREFERRED: serve login + console from same Node origin for Safari cookies.
FRONTEND_URL=http://127.0.0.1:8787
DATA_DIR=./data
# Keep shared host CLI execution off. EACH member pairs their own outbound agent.
BRIDGE_MODE=disabled
ALLOW_MEMBER_JOBS=0
I_ACCEPT_SHARED_CLI_RISK=no
SIGNUP_MODE=open
WROSECODE_BIN=wrosecode
MAX_JOB_SECONDS=300
MAX_CONCURRENT_JOBS=2
# Required for storing each user's API provider keys (generate once, BACK UP safely):
# openssl rand -hex 32
PROVIDER_ENCRYPTION_KEY=
# Local Rust agent API for direct loopback bridge (never expose 4076 publicly).
WROSE_URL=http://127.0.0.1:4076
# Bearer-token file for the Rust server. Defaults check $HOME/.wrosecode/server.token,
# then /root/.wrosecode/server.token and /home/kali/.wrosecode/server.token.
WROSE_TOKEN_FILE=
# Allow each user to add arbitrary public HTTPS model endpoints only after considering SSRF risks
ALLOW_CUSTOM_PROVIDERS=0
# Email/password only by default. Legacy OAuth routes are DISABLED unless explicitly opted in.
ENABLE_SOCIAL_LOGIN=0
# Only for an intentional legacy deployment (NOT needed for email login): Google/GitHub OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Companion ONLY: set on each Windows/macOS/Linux CLI machine (not on the server)
# WROSE_BACKEND_URL=https://your-stable-backend.example.com
# WROSE_WORKSPACE_ROOT=/home/your-user/wrosecode-web-workspace
# WROSE_DEVICE_STATE_FILE= (optional custom local state path)
